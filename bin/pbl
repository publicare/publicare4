#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Pbl\Caminhos;
use Pbl\Console\AssinarComando;
use Pbl\Console\AtualizarComando;
use Pbl\Console\ChavesComando;
use Pbl\Console\ConverterMoldesComando;
use Pbl\Console\CronComando;
use Pbl\Console\DemoPopularComando;
use Pbl\Console\DemoResetarComando;
use Pbl\Console\DominioComando;
use Pbl\Console\ModelosComando;
use Pbl\Console\InstalarComando;
use Pbl\Console\LimparUploadsComando;
use Pbl\Console\EmpacotarComando;
use Pbl\Console\MigrarComando;
use Pbl\Console\AgendadosComando;
use Pbl\Console\PublicarComando;
use Pbl\Console\RedirecionamentoComando;
use Pbl\Console\ReverterComando;
use Pbl\Console\SanitizarHtmlComando;
use Pbl\Console\UsuarioComando;
use Pbl\Console\VerificarAtualizacaoComando;
use Pbl\Console\VersaoComando;
use Symfony\Component\Console\Application;

$aplicacao = new Application('PBL4', Pbl\Versao::ATUAL);
$caminhos = new Caminhos(dirname(__DIR__));
$aplicacao->add(new VersaoComando());
$aplicacao->add(new InstalarComando($caminhos));
$aplicacao->add(new PublicarComando($caminhos));
$aplicacao->add(new AgendadosComando($caminhos));
$aplicacao->add(new CronComando($caminhos));
$aplicacao->add(new SanitizarHtmlComando($caminhos));
$aplicacao->add(new ConverterMoldesComando());
$aplicacao->add(new DominioComando($caminhos));
$aplicacao->add(new RedirecionamentoComando($caminhos));
$aplicacao->add(new UsuarioComando($caminhos));
$aplicacao->add(new MigrarComando($caminhos));
$aplicacao->add(new AtualizarComando($caminhos));
$aplicacao->add(new LimparUploadsComando($caminhos));
$aplicacao->add(new ModelosComando($caminhos));
$aplicacao->add(new DemoPopularComando($caminhos));
$aplicacao->add(new DemoResetarComando($caminhos));
$aplicacao->add(new ReverterComando($caminhos));
$aplicacao->add(new VerificarAtualizacaoComando($caminhos));
$aplicacao->add(new EmpacotarComando());
$aplicacao->add(new ChavesComando());
$aplicacao->add(new AssinarComando());
$aplicacao->run();
