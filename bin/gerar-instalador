#!/usr/bin/env php
<?php

declare(strict_types=1);

// Mantenedor: gera o instalar.php de PRODUÇÃO a partir do modelo (infra/instalador/instalar.php), com as chaves de Pbl\Atualizacao\Chaves.
//   php bin/gerar-instalador [--versao-dica=0.1.0] [--saida=caminho]      (sem --saida: imprime na saída padrão)
//   php bin/gerar-instalador --conferir                                   (falha se o modelo commitado não é o de produção)
require __DIR__ . '/../vendor/autoload.php';

use Pbl\Instalacao\GeradorDoInstalador;

$modelo = (string) file_get_contents(__DIR__ . '/../infra/instalador/instalar.php');
$opcoes = [];
foreach (array_slice($argv, 1) as $a) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/D', $a, $m) !== 1) {
        fwrite(STDERR, "Argumento inválido: {$a}\n");
        exit(2);
    }
    $opcoes[$m[1]] = $m[2] ?? '1';
}
$dica = $opcoes['versao-dica'] ?? '';
if ($dica === '' && preg_match("/const PBLX_VERSAO_DICA = '([^']*)'/", $modelo, $v) === 1) {
    $dica = $v[1];
}
$producao = GeradorDoInstalador::producao($modelo, $dica);
if (isset($opcoes['conferir'])) {
    if ($producao !== $modelo) {
        fwrite(STDERR, "O modelo infra/instalador/instalar.php não corresponde às chaves de Pbl\\Atualizacao\\Chaves. Rode: php bin/gerar-instalador --saida=infra/instalador/instalar.php\n");
        exit(1);
    }
    exit(0);
}
if (isset($opcoes['saida'])) {
    file_put_contents($opcoes['saida'], $producao);
} else {
    echo $producao;
}
