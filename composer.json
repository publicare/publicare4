{
    "name": "publicare/publicare4",
    "description": "PBL4 - plataforma low-code de sites, dados e fluxos",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "doctrine/dbal": "^4.0",
        "symfony/console": "^7.0",
        "symfony/http-foundation": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Pbl\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pbl\\Testes\\": "tests/"
        }
    },
    "config": {
        "platform": {"php": "8.2.0"},
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "teste": "phpunit",
        "analise": "phpstan analyse --memory-limit=512M"
    }
}
