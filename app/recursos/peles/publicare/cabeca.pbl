<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<@-- Metatags de SEO. Título: o de SEO, senão o do conteúdo. `#base_url` é o endereço do domínio principal do site (vazio se não houver), fixado ao publicar. --@>
<@var $titulo_seo = #seo_titulo@>
<@se $titulo_seo == ""@><@var $titulo_seo = #titulo@><@/se@>
<@se $titulo_seo == ""@><@var $titulo_seo = %SITE.config.titulo_padrao@><@/se@>
<@var $descricao_seo = #seo_descricao@>
<@se $descricao_seo == ""@><@var $descricao_seo = #resumo@><@/se@>
<@se $descricao_seo == ""@><@var $descricao_seo = #descricao@><@/se@>
<@se $descricao_seo == ""@><@var $descricao_seo = %SITE.config.descricao@><@/se@>
<@var $imagem_seo = #seo_imagem@>
<@se $imagem_seo == ""@><@var $imagem_seo = #imagem_destaque@><@/se@>
<@se $imagem_seo == ""@><@var $imagem_seo = %SITE.config.imagem_padrao@><@/se@>
<@var $icone_site = %SITE.config.icone@>
<title><@eco $titulo_seo@><@se %SITE.config.titulo_sufixo != ""@> <@eco %SITE.config.titulo_sufixo@><@/se@></title>
<@se $descricao_seo != ""@><meta name="description" content="<@eco $descricao_seo@>">
<@/se@><link rel="canonical" href="<@eco #base_url@><@eco #url@>">
<@se #seo_nao_indexar@><meta name="robots" content="noindex">
<@senao@><@se %SITE.config.robots_indexar == 0@><meta name="robots" content="noindex">
<@/se@><@/se@><meta property="og:title" content="<@eco $titulo_seo@>">
<@se $descricao_seo != ""@><meta property="og:description" content="<@eco $descricao_seo@>">
<@/se@><meta property="og:type" content="<@se #classe == "noticia"@>article<@senao@>website<@/se@>">
<meta property="og:url" content="<@eco #base_url@><@eco #url@>">
<@se #feed_site_url != ""@><link rel="alternate" type="application/rss+xml" title="<@eco #site_nome@>" href="<@eco #feed_site_url@>">
<@/se@><@se #feed_url != ""@><@se #feed_url != #feed_site_url@><link rel="alternate" type="application/rss+xml" title="<@eco #feed_titulo@> - <@eco #site_nome@>" href="<@eco #feed_url@>">
<@/se@><@/se@><meta property="og:site_name" content="<@eco #site_nome@>">
<meta property="og:locale" content="<@eco %SITE.config.idioma@>">
<@se $imagem_seo != ""@><meta property="og:image" content="<@eco #base_url@><@arquivo valor=$imagem_seo info="url"@>">
<meta property="og:image:alt" content="<@eco $titulo_seo@>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<@eco #base_url@><@arquivo valor=$imagem_seo info="url"@>">
<meta name="twitter:image:alt" content="<@eco $titulo_seo@>">
<@senao@><meta property="og:image" content="<@eco #base_url@><@eco #pele_url@>/assets/og-publicare.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Logotipo do <@eco #site_nome@>: um P em forma de peça de quebra-cabeça, em laranja.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<@eco #base_url@><@eco #pele_url@>/assets/og-publicare.png">
<meta name="twitter:image:alt" content="Logotipo do <@eco #site_nome@>: um P em forma de peça de quebra-cabeça, em laranja.">
<@/se@><meta name="twitter:title" content="<@eco $titulo_seo@>">
<@se $descricao_seo != ""@><meta name="twitter:description" content="<@eco $descricao_seo@>">
<@/se@><@-- Dados estruturados (JSON-LD): bloco de dados, não executa (a CSP não o bloqueia nem precisa de exceção). --@>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"<@se #classe == "noticia"@>Article<@senao@>WebPage<@/se@>","name":"<@eco $titulo_seo@>","url":"<@eco #base_url@><@eco #url@>","inLanguage":"<@eco %SITE.config.idioma@>","isPartOf":{"@type":"WebSite","name":"<@eco #site_nome@>","url":"<@eco #base_url@>/"}}</script>
<@se $icone_site != ""@><link rel="icon" href="<@arquivo valor=$icone_site info="url"@>">
<@senao@><link rel="icon" type="image/svg+xml" href="<@eco #pele_url@>/assets/marca.svg">
<@/se@><script src="/_pbl/assets/pbl-barra.js?v=<@eco #barra_v@>" defer></script>
