<@estende "base"@>
<@bloco corpo@>
<header class="pagina-topo"><div class="contem">
<@ecocru #migalhas@>
<h1><@eco #titulo@></h1>
<@se #data_publicacao != ""@><p class="data">Publicado em <@formatadata valor=#data_publicacao formato="d/m/Y"@></p><@/se@>
<@se #resumo != ""@><p class="resumo"><@eco #resumo@></p><@/se@>
</div></header>
<div class="contem miolo">
<article>
<@se #imagem_destaque != ""@><p class="foto-noticia"><img src="<@miniatura valor=#imagem_destaque tamanho=800@>" alt="" width="800" height="420"></p><@/se@>
<div class="corpo"><@ecocru #corpo@></div>
<@tags@>
</article>
</div>
<@/bloco@>
