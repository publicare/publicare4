<@estende "base"@>
<@bloco corpo@>
<header class="pagina-topo"><div class="contem">
<@ecocru #migalhas@>
<h1><@eco #titulo@></h1>
<p class="evento-quando"><@formatadata valor=#inicio formato="d/m/Y H:i"@><@se #fim != ""@> até <@formatadata valor=#fim formato="d/m/Y H:i"@><@/se@><@se #local != ""@> · <@eco #local@><@/se@></p>
<@se #resumo != ""@><p class="resumo"><@eco #resumo@></p><@/se@>
</div></header>
<div class="contem miolo">
<article>
<@se #imagem != ""@><p class="foto-noticia"><img src="<@miniatura valor=#imagem tamanho=800@>" alt="" width="800" height="420"></p><@/se@>
<div class="corpo"><@ecocru #corpo@></div>
<@se #link_inscricao != ""@><p><a class="botao" href="<@ecourl #link_inscricao@>" rel="noopener noreferrer">Inscreva-se</a></p><@/se@>
</article>
</div>
<@/bloco@>
