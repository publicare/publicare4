<@estende "layout"@>
<@bloco lateral@><@ecocru #menu@><@/bloco@>
<@bloco miolo@>
<h1><@eco #titulo@></h1>
<@se #resumo@><p class="resumo"><@eco #resumo@></p><@/se@>
<ul class="capitulos">
<@filhos classes="manual_pagina" ordem="peso, titulo"@><li><a href="<@eco #url@>/"><strong><@eco #titulo@></strong></a><span><@eco #resumo@></span></li>
<@/filhos@></ul>
<@/bloco@>
