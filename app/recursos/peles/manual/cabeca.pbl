<@-- Pele do manual: metatags de SEO da pele básica, sem o que não se aplica. Sem CDN: tudo vem de assets/ da própria pele. --@>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<@var $titulo_seo = #titulo@>
<@se $titulo_seo == ""@><@var $titulo_seo = %SITE.config.titulo_padrao@><@/se@>
<@var $descricao_seo = #resumo@>
<@se $descricao_seo == ""@><@var $descricao_seo = %SITE.config.descricao@><@/se@>
<title><@eco $titulo_seo@> - <@eco #site_nome@></title>
<@se $descricao_seo != ""@><meta name="description" content="<@eco $descricao_seo@>">
<@/se@><link rel="canonical" href="<@eco #base_url@><@eco #url@>">
<@se %SITE.config.robots_indexar == 0@><meta name="robots" content="noindex">
<@/se@><meta property="og:title" content="<@eco $titulo_seo@>">
<meta property="og:type" content="website">
<meta property="og:url" content="<@eco #base_url@><@eco #url@>">
<script src="<@eco #pele_url@>/assets/manual-tema.js?v=<@eco #pele_v@>"></script>
<link rel="stylesheet" href="<@eco #pele_url@>/assets/manual.css?v=<@eco #pele_v@>">
<link rel="stylesheet" href="<@eco #pele_url@>/assets/manual-impressao.css?v=<@eco #pele_v@>" media="print">
<script src="<@eco #pele_url@>/assets/manual.js?v=<@eco #pele_v@>" defer></script>
<script src="/_pbl/assets/pbl-barra.js?v=<@eco #barra_v@>" defer></script>
