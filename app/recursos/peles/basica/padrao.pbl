<!doctype html>
<html lang="pt-BR">
<head>
<@incluir arquivo="cabeca"@>
<style>
body{font-family:system-ui,sans-serif;max-width:46rem;margin:2rem auto;padding:0 1rem;line-height:1.6;color:#222}
nav a{margin-right:1rem}
</style>
</head>
<body>
<h1><@eco #titulo@></h1>
<@se #resumo@><p><em><@eco #resumo@></em></p><@/se@>
<div><@ecocru #corpo@></div>
<nav>
<@filhos@><@se #classe == "link"@><@incluir arquivo="link_a"@><@senao@><a href="<@eco #url@>"><@eco #titulo@></a><@/se@><@/filhos@>
</nav>
</body>
</html>
