<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<main>
<@se #id == #raiz@><@incluir arquivo="faixa_destaques"@><@/se@>
<h1><@eco #titulo@></h1>
<@se #resumo@><p class="resumo"><@eco #resumo@></p><@/se@>
<div class="corpo"><@ecocru #corpo@></div>
<nav class="navegacao-filhos">
<@filhos@><@se #classe == "link"@><@incluir arquivo="link_a"@><@senao@><a href="<@eco #url@>"><@eco #titulo@></a><@/se@> <@/filhos@>
</nav>
</main>
<@se %SITE.config.rodape != ""@><footer><@ecocru %SITE.config.rodape@></footer>
<@/se@><@incluir arquivo="bloco_rodape"@>
</body>
</html>
