<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<main>
<article>
<h1><@eco #titulo@></h1>
<p class="evento-quando"><@formatadata valor=#inicio formato="d/m/Y H:i"@><@se #fim != ""@> até <@formatadata valor=#fim formato="d/m/Y H:i"@><@/se@></p>
<@se #local != ""@><p><strong>Local:</strong> <@eco #local@></p><@/se@>
<@se #imagem != ""@><p class="foto-noticia"><img src="<@miniatura valor=#imagem tamanho=800@>" alt=""></p><@/se@>
<@se #resumo != ""@><p class="resumo"><@eco #resumo@></p><@/se@>
<div class="corpo"><@ecocru #corpo@></div>
<@se #link_inscricao != ""@><p><a href="<@ecourl #link_inscricao@>" rel="noopener noreferrer">Inscreva-se</a></p><@/se@>
</article>
</main>
<@incluir arquivo="bloco_rodape"@>
</body>
</html>
