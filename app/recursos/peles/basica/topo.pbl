<@incluir arquivo="bloco_aviso"@>
<header class="topo">
<a class="marca" href="/"><@se %SITE.config.logo != ""@><img src="<@arquivo valor=%SITE.config.logo info="url"@>" alt=""><@/se@><span><@eco #site_nome@></span></a>
<button class="topo-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#topo-nav" aria-controls="topo-nav" aria-expanded="false" aria-label="Abrir o menu"><span class="topo-toggle-barras" aria-hidden="true"></span></button>
<div class="topo-nav collapse" id="topo-nav">
<@se %SITE.config.busca_ligada == 1@><form class="busca" action="/busca" method="get" role="search"><label class="so-leitor" for="busca-q">Buscar no site</label><input id="busca-q" type="search" name="q" value="<@eco $q@>" maxlength="200" placeholder="Buscar no site"> <button type="submit">Buscar</button></form>
<@/se@><@menu profundidade=3 inicio="Início"@>
</div>
</header>
