<@-- Modelo "home": página inicial do site (ou da subárvore que usa esta pele). Ordem: cabeçalho, hero (título, slogan e destaque principal), atalhos em cartões grandes (links publicados diretamente sob a página inicial), faixa de destaques, corpo, últimas notícias e links rápidos. Cada bloco só aparece se houver conteúdo. --@>
<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<main>
<@var $home = #id@>
<section class="hero" aria-label="Apresentação">
<h1><@eco #titulo@></h1>
<@var $slogan = #resumo@><@se $slogan == ""@><@var $slogan = %SITE.config.slogan@><@/se@>
<@se $slogan != ""@><p class="resumo"><@eco $slogan@></p><@/se@>
<@var $tem_principal = 0@>
<@localizar classes="destaque" ordem="peso, titulo" limite=1 expandir="destino_interno"@>
<@var $tem_principal = 1@><div class="destaque-principal">
<@se #imagem != ""@><img src="<@miniatura valor=#imagem tamanho=1200@>" alt="" fetchpriority="high"><@/se@>
<div class="destaque-texto">
<h2><@eco #titulo@></h2>
<@se #texto != ""@><p><@eco #texto@></p><@/se@>
<@var $dest = #destino_externo@><@se #destino_interno != ""@><@var $dest = #destino_interno.url@><@/se@>
<@se $dest != ""@><p><a href="<@ecourl $dest@>"<@se #destino_interno == ""@> rel="noopener noreferrer"<@/se@><@se #nova_aba@> target="_blank"<@/se@>>Saiba mais<span class="so-leitor"> sobre <@eco #titulo@></span></a></p><@/se@>
</div>
</div>
<@/localizar@>
<@se $tem_principal == 0@><@se %SITE.config.imagem_hero != ""@><div class="destaque-principal"><img src="<@miniatura valor=%SITE.config.imagem_hero tamanho=1200@>" alt="" fetchpriority="high"></div>
<@/se@><@/se@></section>
<@var $atalhos = 0@>
<@filhos classes="link" ordem="peso, titulo" limite=4@>
<@var $dest = #destino_externo@><@se #destino_interno != ""@><@var $dest = #destino_interno.url@><@/se@>
<@se $dest != ""@><@se $atalhos == 0@><section class="atalhos" aria-label="Em destaque"><ul>
<@var $atalhos = 1@><@/se@><li><a class="cartao-atalho" href="<@ecourl $dest@>"<@se #destino_interno == ""@> rel="noopener noreferrer"<@/se@><@se #nova_aba@> target="_blank"<@/se@>><span class="titulo"><@eco #titulo@></span><@se #descricao != ""@><span class="texto"><@eco #descricao@></span><@/se@><span class="seta" aria-hidden="true">Abrir &rarr;</span></a></li>
<@/se@><@/filhos@>
<@se $atalhos == 1@></ul></section>
<@/se@><@localizar classes="destaque" ordem="peso, titulo" inicio=1 limite=3 expandir="destino_interno"@>
<@se %INDICE == 1@><section class="destaques" aria-label="Destaques">
<@/se@><article class="destaque">
<@se #imagem != ""@><img src="<@miniatura valor=#imagem tamanho=800@>" alt="" loading="lazy" decoding="async"><@/se@>
<h2><@eco #titulo@></h2>
<@se #texto != ""@><p><@eco #texto@></p><@/se@>
<@var $dest = #destino_externo@><@se #destino_interno != ""@><@var $dest = #destino_interno.url@><@/se@>
<@se $dest != ""@><a href="<@ecourl $dest@>"<@se #destino_interno == ""@> rel="noopener noreferrer"<@/se@><@se #nova_aba@> target="_blank"<@/se@>>Saiba mais<span class="so-leitor"> sobre <@eco #titulo@></span></a><@/se@>
</article>
<@se %INDICE == %QUANTIDADE@></section>
<@/se@><@/localizar@>
<@se #corpo != ""@><div class="corpo"><@ecocru #corpo@></div>
<@/se@><@localizar classes="noticia" ordem="-data_publicacao, titulo" limite=5@>
<@se %INDICE == 1@><section class="ultimas" aria-label="Últimas notícias"><h2>Últimas notícias</h2>
<@/se@><@incluir arquivo="item"@>
<@se %INDICE == %QUANTIDADE@></section>
<@/se@><@/localizar@>
<@var $rapidos = 0@>
<@localizar classes="link" ordem="peso, titulo" limite=12@>
<@se #pai != $home@><@se $rapidos == 0@><section class="links-rapidos" aria-label="Links rápidos"><h2>Links rápidos</h2><ul>
<@var $rapidos = 1@><@/se@><li><@incluir arquivo="link_a"@></li>
<@/se@><@/localizar@>
<@se $rapidos == 1@></ul></section>
<@/se@></main>
<@se %SITE.config.rodape != ""@><footer><@ecocru %SITE.config.rodape@></footer>
<@/se@><@incluir arquivo="bloco_rodape"@>
</body>
</html>
