<!doctype html>
<html lang="pt-BR">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body>
<@incluir arquivo="topo"@>
<main>
<h1><@eco #titulo@></h1>
<@se #descricao != ""@><p><@eco #descricao@></p><@/se@>
<@var $tem_mais = 0@>
<@var $inicio_da_pagina = ($pagina - 1) * 10@>
<@filhos ordem="-data_publicacao, peso, titulo" inicio=$inicio_da_pagina limite=11@><@se %INDICE <= 10@><@incluir arquivo="item"@><@senao@><@var $tem_mais = 1@><@/se@><@/filhos@>
<@semfilhos@><p>Nada por aqui ainda.</p><@/semfilhos@>
<@incluir arquivo="paginacao"@>
</main>
</body>
</html>
