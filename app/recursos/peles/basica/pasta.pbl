<!doctype html>
<html lang="pt-BR">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body>
<@incluir arquivo="topo"@>
<main>
<h1><@eco #titulo@></h1>
<@se #descricao != ""@><p><@eco #descricao@></p><@/se@>
<@var $tem_mais = 0@>
<@var $por_pagina = %SITE.config.itens_por_pagina@>
<@var $inicio_da_pagina = ($pagina - 1) * $por_pagina@>
<@var $limite_lista = $por_pagina + 1@>
<@filhos ordem="-data_publicacao, peso, titulo" inicio=$inicio_da_pagina limite=$limite_lista@><@se %INDICE <= $por_pagina@><@incluir arquivo="item"@><@senao@><@var $tem_mais = 1@><@/se@><@/filhos@>
<@semfilhos@><p>Nada por aqui ainda.</p><@/semfilhos@>
<@incluir arquivo="paginacao"@>
</main>
</body>
</html>
