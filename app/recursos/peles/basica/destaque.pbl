<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<main>
<h1><@eco #titulo@></h1>
<@se #imagem != ""@><p><img src="<@miniatura valor=#imagem tamanho=800@>" alt="" style="max-width:100%;height:auto"></p><@/se@>
<@se #texto != ""@><p><@eco #texto@></p><@/se@>
<@var $dest = #destino_externo@><@se #destino_interno != ""@><@var $dest = #destino_interno.url@><@/se@>
<@se $dest != ""@><p><a href="<@eco $dest@>"<@se #destino_interno == ""@> rel="noopener noreferrer"<@/se@>>Saiba mais</a></p><@/se@>
</main>
</body>
</html>
