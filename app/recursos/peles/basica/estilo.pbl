<@-- Pele básica: folha de estilos e scripts do próprio site (assets/), todos com ?v= da pele (cache longo, renova quando muda) e sem nada embutido na página. pbl-js.js (síncrono, minúsculo) marca html.js; o resto é defer e opcional: sem JavaScript o site continua legível e navegável. --@>
<link rel="stylesheet" href="<@eco #pele_url@>/assets/pele.css?v=<@eco #pele_v@>">
<script src="<@eco #pele_url@>/assets/pbl-js.js?v=<@eco #pele_v@>"></script>
<script src="<@eco #pele_url@>/assets/bootstrap.bundle.min.js?v=<@eco #pele_v@>" defer></script>
<script src="<@eco #pele_url@>/assets/pbl-pele.js?v=<@eco #pele_v@>" defer></script>
