<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
<@incluir arquivo="estilo"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<main>
<article>
<h1><@eco #titulo@></h1>
<@se #data_publicacao != ""@><p class="data">Publicado em <@formatadata valor=#data_publicacao formato="d/m/Y"@></p><@/se@>
<@se #imagem_destaque != ""@><p class="foto-noticia"><img src="<@miniatura valor=#imagem_destaque tamanho=800@>" alt=""></p><@/se@>
<@se #resumo != ""@><p class="resumo"><@eco #resumo@></p><@/se@>
<div class="corpo"><@ecocru #corpo@></div>
<@tags@>
</article>
</main>
</body>
</html>
