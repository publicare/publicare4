<@-- Pele "portal": na raiz da pele, página inicial (hero com carrossel, últimas notícias e conteúdo); nas demais, página interna. --@>
<!doctype html>
<html lang="<@eco %SITE.config.idioma@>">
<head>
<@incluir arquivo="cabeca"@>
</head>
<body data-pbl-objeto="<@eco #id@>">
<@incluir arquivo="topo"@>
<@se #id == #raiz_pele@>
<@var $slides = 0@>
<@localizar classes="destaque" pai=#raiz_pele niveis=3 ordem="peso, titulo" limite=5 expandir="destino_interno"@>
<@se %INDICE == 1@><section class="pt-hero carousel slide" id="pt-carrossel" data-bs-ride="carousel" aria-label="Destaques"><div class="carousel-inner">
<@/se@><div class="carousel-item<@se %INDICE == 1@> active<@/se@>">
<@se #imagem != ""@><img src="<@miniatura valor=#imagem tamanho=1200@>" alt=""><@/se@>
<div class="carousel-caption"><h2 class="h3"><@eco #titulo@></h2>
<@se #texto != ""@><p><@eco #texto@></p><@/se@>
<@var $dest = #destino_externo@><@se #destino_interno != ""@><@var $dest = #destino_interno.url@><@/se@>
<@se $dest != ""@><a class="btn btn-light" href="<@ecourl $dest@>"<@se #destino_interno == ""@> rel="noopener noreferrer"<@/se@>>Saiba mais<span class="visually-hidden"> sobre <@eco #titulo@></span></a><@/se@>
</div></div>
<@se %INDICE == %QUANTIDADE@></div>
<button class="carousel-control-prev" type="button" data-bs-target="#pt-carrossel" data-bs-slide="prev"><span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Anterior</span></button>
<button class="carousel-control-next" type="button" data-bs-target="#pt-carrossel" data-bs-slide="next"><span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Próximo</span></button>
</section>
<@/se@><@var $slides = %QUANTIDADE@><@/localizar@>
<@se $slides == 0@><@se %SITE.config.imagem_hero != ""@><section class="pt-hero"><img class="w-100" style="max-height:24rem;object-fit:cover" src="<@miniatura valor=%SITE.config.imagem_hero tamanho=1200@>" alt=""></section>
<@/se@><@/se@>
<main id="conteudo" class="container py-4">
<h1><@eco #titulo@></h1>
<@se #resumo != ""@><p class="lead"><@eco #resumo@></p><@/se@>
<div><@ecocru #corpo@></div>
<div class="row g-4">
<@localizar classes="noticia" pai=#raiz_pele niveis=4 ordem="-data_publicacao, titulo" limite=6@>
<@se %INDICE == 1@><section class="col-12" aria-label="Últimas notícias"><h2 class="h4">Últimas notícias</h2>
<@/se@><@incluir arquivo="item"@>
<@se %INDICE == %QUANTIDADE@></section>
<@/se@><@/localizar@>
</div>
<@filhos classes="pasta,pagina" ordem="peso, titulo" limite=12@>
<@se %INDICE == 1@><section aria-label="Seções" class="mt-4"><h2 class="h4">Seções</h2><div class="row row-cols-1 row-cols-md-3 g-3">
<@/se@><div class="col"><div class="card h-100"><div class="card-body"><h3 class="h5 card-title"><a class="stretched-link" href="<@eco #url@>"><@eco #titulo@></a></h3>
<@se #resumo != ""@><p class="card-text"><@eco #resumo@></p><@senao@><@se #descricao != ""@><p class="card-text"><@eco #descricao@></p><@/se@><@/se@></div></div></div>
<@se %INDICE == %QUANTIDADE@></div></section>
<@/se@><@/filhos@>
</main>
<@senao@>
<main id="conteudo" class="container py-4">
<@ecocru #migalhas@>
<article>
<h1><@eco #titulo@></h1>
<@se #resumo != ""@><p class="lead"><@eco #resumo@></p><@/se@>
<div><@ecocru #corpo@></div>
</article>
</main>
<@/se@>
<@incluir arquivo="rodape"@>
</body>
</html>
